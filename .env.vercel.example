# Vercel environment-variable template for the `web` and `api` services in
# vercel.json. Configure these in Vercel; do not upload or commit your real .env.
# Replace every placeholder before deploying.

# -----------------------------------------------------------------------------
# Web service
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://campusconnect.soha.works
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Leave NEXT_PUBLIC_API_URL unset in production. The browser uses /api/v1.
# API_SERVICE_URL is injected by the service binding in vercel.json; do not set it.

# -----------------------------------------------------------------------------
# API service
# -----------------------------------------------------------------------------
NODE_ENV=production
API_URL=https://campusconnect.soha.works
WEB_URL=https://campusconnect.soha.works
# Use the production origin here; set the exact preview origin in Vercel Preview
# environments if preview deployments need to call the API.
CORS_ORIGINS=https://campusconnect.soha.works

# Use the Supabase Session Pooler URL on port 5432 (never the transaction pooler).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Generate separate random secrets of at least 32 characters. Production refuses
# the placeholders below. QR_TOKEN_SECRET may be omitted to reuse the access secret.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-different-refresh-secret
QR_TOKEN_SECRET=change-me-qr-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12

# Production requires durable storage and a real mail transport.
STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=your-production-bucket
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
MAX_UPLOAD_MB=10

MAIL_DRIVER=smtp
MAIL_FROM="CampusConnect <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Optional integrations
AI_DRIVER=rule-based
PAYMENT_DRIVER=stub
SENTRY_DSN=
