co# =============================================================================
# CampusConnect — Environment Configuration
# Copy to `.env` and fill in. Never commit the real .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
# Comma-separated list of allowed browser origins for CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# -----------------------------------------------------------------------------
# Database (matches docker-compose.yml)
# -----------------------------------------------------------------------------
POSTGRES_USER=campusconnect
POSTGRES_PASSWORD=campusconnect
POSTGRES_DB=campusconnect
POSTGRES_PORT=5432
DATABASE_URL="postgresql://campusconnect:campusconnect@localhost:5432/campusconnect?schema=public"

# -----------------------------------------------------------------------------
# Auth / JWT
# Generate real secrets with: openssl rand -base64 48
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-in-production-000000
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-in-production-0000
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12
# Secret used to sign event-pass QR tokens (HMAC). Falls back to JWT_ACCESS_SECRET if unset.
QR_TOKEN_SECRET=dev-only-qr-secret-change-me-in-production-00000000

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# -----------------------------------------------------------------------------
# Storage — `local` (dev) or `s3` (prod). See apps/api/src/services/storage
# -----------------------------------------------------------------------------
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./uploads
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=campusconnect-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_MB=10

# -----------------------------------------------------------------------------
# Email — `console` (dev, logs to stdout) or `smtp`
# Push and WhatsApp/SMS are stubbed adapters; fill these in when wiring a provider.
# -----------------------------------------------------------------------------
MAIL_DRIVER=console
MAIL_FROM="CampusConnect <no-reply@campusconnect.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

PUSH_DRIVER=stub
PUSH_SERVER_KEY=
WHATSAPP_DRIVER=stub
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# -----------------------------------------------------------------------------
# Payments — Razorpay-ready, stubbed in Phase 1
# -----------------------------------------------------------------------------
PAYMENT_DRIVER=stub
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# AI service adapters — `rule-based` (Phase 1 stub) or `llm`
# See apps/api/src/services/ai/README.md for the swap contract.
# -----------------------------------------------------------------------------
AI_DRIVER=rule-based
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Public marketing config (exposed to the web app; all values are PLACEHOLDERS)
# See apps/web/src/lib/site-config.ts
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# -----------------------------------------------------------------------------
# Error monitoring hook (optional — no-op when unset)
# -----------------------------------------------------------------------------
SENTRY_DSN=

# -----------------------------------------------------------------------------
# Seed script
# -----------------------------------------------------------------------------
SEED_DEFAULT_PASSWORD=Password@123
