// =============================================================================
// CampusConnect — Prisma schema
// =============================================================================
//
// Conventions used throughout:
//
//  * Every model carries `createdAt` / `updatedAt`. Models whose rows are shown
//    to users carry `deletedAt` for soft delete; hard delete is reserved for
//    true join rows and for records removed by a data-subject request.
//
//  * Multi-tenancy is by `collegeId`. Every college-scoped model indexes it, and
//    every service method that reads such a model filters on the caller's
//    collegeId. A row with `collegeId = null` is platform-global (e.g. a
//    reference skill) and readable by all tenants, never writable by them.
//
//  * Enums are declared as Prisma enums, mirroring the string unions in
//    `@campusconnect/shared`. The shared package is the display/copy source of
//    truth; this schema is the storage source of truth. A unit test asserts the
//    two lists match so they cannot drift silently.
//
//  * RBAC is enforced in code (`packages/shared/src/rbac.ts`), not in the
//    database. The `Role` table below exists as *reference data* — it backs the
//    admin UI's permission matrix and keeps role metadata queryable — but
//    `User.role` is the value the auth middleware reads. There is deliberately
//    no `permissions` JSON column that could be edited at runtime and diverge
//    from what the middleware enforces.
//
// Phase 1 tables are implemented end-to-end. Phase 2/3 tables (skills, courses,
// projects, internships, jobs, applications, interviews, payments) are defined
// now so the schema is stable and a single migration covers the roadmap; their
// routes and services arrive in later phases as `TODO(Phase N)` markers note.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum RoleKey {
  STUDENT
  CLUB_LEAD
  FACULTY_COORDINATOR
  COLLEGE_ADMIN
  TRAINER
  EMPLOYER
  SUPER_ADMIN
}

enum UserStatus {
  PENDING_INVITE
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum EventCategory {
  WORKSHOP
  SEMINAR
  HACKATHON
  COMPETITION
  BOOTCAMP
  WEBINAR
  CULTURAL
  SPORTS
  FEST
  CLUB_ACTIVITY
  PLACEMENT_DRIVE
  OTHER
}

