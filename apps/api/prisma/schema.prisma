  ONLINE
  OFFLINE
  HYBRID
}

enum EventStatus {
  DRAFT
  PENDING_FACULTY
  PENDING_ADMIN
  PUBLISHED
  REJECTED
  ONGOING
  COMPLETED
  CANCELLED
}

